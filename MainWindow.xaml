<Window
    x:Class="GameMonitor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Game Monitor">

    <Grid x:Name="RootGrid" Background="Transparent" SizeChanged="RootGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            Title="Game Monitor"
            Subtitle="MSI Afterburner">
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xE9D9;"/>
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button
                        x:Name="FullScreenButton"
                        Width="40"
                        Height="36"
                        Click="FullScreenButton_Click"
                        ToolTipService.ToolTip="全屏">
                        <FontIcon Glyph="&#xE740;" FontSize="16"/>
                    </Button>
                    <Button
                        x:Name="SettingsButton"
                        Width="40"
                        Height="36"
                        Click="SettingsButton_Click"
                        ToolTipService.ToolTip="设置">
                        <FontIcon Glyph="&#xE713;" FontSize="16"/>
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <Grid x:Name="MonitorLayout" Grid.Row="1" Padding="24,16,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PrimaryColumn" Width="*"/>
                <ColumnDefinition x:Name="SecondaryColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <StackPanel
                x:Name="IdentityPanel"
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,0,16"
                Spacing="4">
                <TextBlock
                    x:Name="CpuNameText"
                    Text="CPU"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"/>
                <TextBlock
                    x:Name="GpuNameText"
                    Text="GPU"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Border
                x:Name="FpsPanel"
                Grid.Row="1"
                Grid.Column="0"
                Padding="24"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <TextBlock
                            x:Name="FpsValueText"
                            Text="--"
                            Foreground="{StaticResource MonitorAccentBrush}"
                            FontFamily="Segoe UI Variable Display"
                            FontSize="144"
                            FontWeight="SemiBold"
                            LineHeight="150"
                            TextAlignment="Center"/>
                        <TextBlock
                            Text="FPS"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="24"
                            HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="24">
                        <TextBlock x:Name="FrameTimeText" Text="帧生成 --"/>
                        <TextBlock x:Name="LowFpsText" Text="1% Low --"/>
                        <TextBlock x:Name="AverageFpsText" Text="平均 --"/>
                    </StackPanel>
                </Grid>
            </Border>

            <GridView
                x:Name="MetricsGrid"
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="1"
                Margin="20,0,0,0"
                ItemsSource="{x:Bind MetricCards, Mode=OneWay}"
                IsItemClickEnabled="False"
                SelectionMode="None"
                ScrollViewer.HorizontalScrollMode="Disabled"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="6"/>
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Width="236"
                            Height="108"
                            Padding="16"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Text="{Binding Label}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis"/>
                                <TextBlock
                                    Grid.Row="1"
                                    Text="{Binding Value}"
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Bottom"
                                    TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse
                    x:Name="ConnectionIndicator"
                    Width="8"
                    Height="8"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Fill="{ThemeResource SystemFillColorCriticalBrush}"/>
                <TextBlock
                    x:Name="StatusText"
                    Grid.Column="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="正在等待 MSI Afterburner"
                    TextTrimming="CharacterEllipsis"/>
                <TextBlock
                    x:Name="UpdatedAtText"
                    Grid.Column="2"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="--"/>
            </Grid>
        </Grid>

        <ContentDialog
            x:Name="SettingsDialog"
            Grid.RowSpan="2"
            Title="设置"
            PrimaryButtonText="保存"
            CloseButtonText="取消"
            DefaultButton="Primary"
            PrimaryButtonClick="SettingsDialog_PrimaryButtonClick">
            <ScrollViewer MaxHeight="560">
                <StackPanel Width="420" Spacing="18">
                    <TextBlock
                        x:Name="RefreshLabel"
                        Text="刷新间隔"
                        Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <NumberBox
                        x:Name="RefreshIntervalBox"
                        Minimum="250"
                        Maximum="10000"
                        SmallChange="250"
                        SpinButtonPlacementMode="Inline"
                        Header="毫秒"/>

                    <ComboBox
                        x:Name="TemperatureUnitBox"
                        Header="温度单位"
                        SelectedIndex="0">
                        <ComboBoxItem Content="摄氏度 (°C)" Tag="C"/>
                        <ComboBoxItem Content="华氏度 (°F)" Tag="F"/>
                    </ComboBox>

                    <ComboBox
                        x:Name="LanguageBox"
                        Header="语言"
                        SelectedIndex="0">
                        <ComboBoxItem Content="中文" Tag="zh"/>
                        <ComboBoxItem Content="English" Tag="en"/>
                    </ComboBox>

                    <TextBlock
                        x:Name="DisplayItemsLabel"
                        Text="显示项目"
                        Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <ItemsControl ItemsSource="{x:Bind DisplayOptions, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox
                                    Margin="0,4"
                                    Content="{Binding Label}"
                                    IsChecked="{Binding IsEnabled, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Window>
